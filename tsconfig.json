{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "skipLibCheck": true, "isolatedModules": true, "noEmit": true
  },
  "include": ["src", "content", "tests", "preview"]
}
